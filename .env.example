# MicroClaw — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
#
# These override config.json values. Only set what you need.

# ── AI Provider (choose one as primary) ────────────────────
# MICROCLAW_PROVIDER=claude
# MICROCLAW_PROVIDER=openai
# MICROCLAW_PROVIDER=gemini
# MICROCLAW_PROVIDER=ollama

# ── API Keys (BYOK — bring your own keys) ─────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AI...

# ── Ollama (local models, no API key needed) ───────────────
# OLLAMA_HOST=http://localhost:11434

# ── Telegram ───────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-...

# ── Discord ────────────────────────────────────────────────
# DISCORD_BOT_TOKEN=MTIz...

# ── Slack ──────────────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_SIGNING_SECRET=...

# ── WhatsApp (Meta Cloud API) ─────────────────────────────
# WHATSAPP_TOKEN=EAAx...
# WHATSAPP_PHONE_ID=123456789
# WHATSAPP_VERIFY_TOKEN=my-verify-token
# WHATSAPP_APP_SECRET=...

# ── WebChat ────────────────────────────────────────────────
# WEBCHAT_AUTH_TOKEN=my-secret-token

# ── Logging ──────────────────────────────────────────────
# MICROCLAW_FILE_LOG=true                           # Enable file logging (~/.microclaw/logs/)
# MICROCLAW_LOG_FILE=/path/to/custom/microclaw.log  # Custom log file path (also enables file logging)
